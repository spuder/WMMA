# Copy to .env. Values can be 1Password secret references (op://vault/item/field)
# and resolved at startup with: op run --env-file=.env -- docker compose up -d

# Tailscale auth key for the sidecar (tag it, e.g. tag:wmma)
TS_AUTHKEY=op://Private/WMMA/tailscale-authkey

# Comma-separated Tailscale login names allowed to use WMMA
WMMA_ALLOWED_USERS=you@example.com

WMMA_TZ=America/Denver

# Optional
JEV_API_KEY=
SIMPLEFIN_ACCESS_URL=
SIMPLEFIN_SYNC_CRON=
YNAB_TOKEN=
